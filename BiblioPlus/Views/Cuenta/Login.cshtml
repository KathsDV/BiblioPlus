@{
    ViewBag.Title = "Iniciar Sesión - Biblio Plus";
}

<style>
    body, h1, h2, h3, h4, h5, h6, label, p, a {
        font-family: 'Inter', sans-serif;
    }

    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 60px);
        padding: 20px;
    }

    .login-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        padding: 50px 40px;
        width: 100%;
        max-width: 420px;
        text-align: center;
    }

        .login-card h2 {
            color: #343a40;
            margin-bottom: 35px;
            font-size: 2.2rem;
            font-weight: 700;
        }

    .form-group-with-icon {
        margin-bottom: 25px;
        position: relative;
        text-align: left;
    }

        .form-group-with-icon label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #495057;
        }

        .form-group-with-icon .form-control {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            padding: 12px 15px 12px 45px;
            height: auto;
            font-size: 1.05rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .form-group-with-icon .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.2);
            }

        .form-group-with-icon .input-icon {
            position: absolute;
            left: 15px;
            top: 45px;
            color: #6c757d;
            font-size: 1.2rem;
        }

        .form-group-with-icon input:focus + .input-icon,
        .form-group-with-icon .form-control:focus ~ .input-icon {
            color: #007bff;
        }

    .toggle-password {
        position: absolute;
        right: 15px;
        top: 45px;
        cursor: pointer;
        color: #6c757d;
        font-size: 1.1rem;
        transition: color 0.3s ease;
    }

        .toggle-password:hover {
            color: #007bff;
        }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        padding: 14px 30px;
        font-size: 1.2rem;
        border-radius: 8px;
        margin-top: 10px; /* <--- AJUSTE CLAVE AQUÍ: REDUCIDO A 10PX */
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: background-color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
        width: 100%;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 123, 255, 0.3);
        }

    .field-validation-error {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
        text-align: left;
    }

    .register-link-text {
        margin-top: 25px;
        color: #6c757d;
        font-size: 1rem;
    }

        .register-link-text a {
            color: #007bff;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }

            .register-link-text a:hover {
                color: #0056b3;
                text-decoration: underline;
            }
</style>

<div class="login-container">
    <div class="login-card">
        <h2>Iniciar Sesión</h2>

        @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group-with-icon">
                <label for="correo">Correo electrónico:</label>
                <input type="email" id="correo" name="correo" required class="form-control" placeholder="ejemplo@correo.com" />
                <i class="fas fa-envelope input-icon"></i>
            </div>

            <div class="form-group-with-icon">
                <label for="clave">Contraseña:</label>
                <input type="password" id="clave" name="clave" required class="form-control" placeholder="Ingrese su contraseña" />
                <i class="fas fa-lock input-icon"></i>
                <i class="fas fa-eye toggle-password" id="togglePasswordLogin"></i>
            </div>

            <div>
                <input type="submit" value="Iniciar Sesión" class="btn btn-primary btn-block" />
            </div>

            if (ViewBag.Error != null)
            {
                <p class="field-validation-error mt-3" style="text-align: center;">@ViewBag.Error</p>
            }

            <p class="register-link-text">¿No tienes cuenta? <a href="@Url.Action("Registro", "Cuenta")">Regístrate aquí</a></p>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePassword = document.querySelector('#togglePasswordLogin');
            const password = document.querySelector('#clave');

            if (togglePassword && password) {
                togglePassword.addEventListener('click', function (e) {
                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                    password.setAttribute('type', type);
                    this.classList.toggle('fa-eye');
                    this.classList.toggle('fa-eye-slash');
                });
            }
        });
    </script>
}