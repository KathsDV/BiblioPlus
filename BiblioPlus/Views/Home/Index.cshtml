@model IEnumerable<BiblioPlus.Models.LIBRO>

@{
    ViewBag.Title = "Consulta de Libros - Biblio Plus";
    var sugerencias = ViewBag.Sugerencias as List<BiblioPlus.Models.LIBRO>;
    var usuarioEnSesion = Session["Usuario"];
}
<style>
    .info-banner {
        background-color: #e7f3fe;
        color: #0c5460;
        border: 1px solid #bee5eb;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        font-family: 'Segoe UI', sans-serif;
    }

        .info-banner i {
            font-size: 24px;
            margin-right: 15px;
            color: #0c5460;
        }

    .section-title {
        font-size: 28px;
        margin-bottom: 20px;
        font-weight: 700;
        color: #2c3e50;
        text-align: center;
        font-family: 'Inter', sans-serif;
    }

    .book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }

    .book-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.05);
        background-color: #fff;
        transition: transform 0.2s;
    }

        .book-card:hover {
            transform: scale(1.02);
        }

    .book-details-collapsed {
        display: none;
        margin-top: 10px;
        font-size: 14px;
        color: #555;
    }

        .book-details-collapsed.show {
            display: block;
        }

    .toggle-details-btn {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        margin-top: 10px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.3s;
    }

        .toggle-details-btn:hover {
            background-color: #0056b3;
        }

    .suggestions-section {
        margin-top: 40px;
        text-align: center;
    }

        .suggestions-section h3 {
            margin-bottom: 20px;
            font-size: 24px;
            font-weight: bold;
            color: #333;
        }

    .suggestion-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 15px;
        justify-content: flex-start;
        padding-bottom: 10px;
    }

    .suggestion-item {
        flex: 0 0 auto;
        background-color: #cce5ff;
        border: 1px solid #b8daff;
        border-radius: 6px;
        padding: 10px 15px;
        min-width: 250px;
        font-size: 15px;
        color: #004085;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .suggestion-item i {
            color: #004085;
        }

    .suggestion-empty {
        color: #6c757d;
        font-style: italic;
        font-size: 16px;
    }
</style>
<div class="container py-4">

    @* Banner solo si el usuario no ha iniciado sesión *@
    @if (usuarioEnSesion == null)
    {
        <div class="info-banner">
            <i class="fas fa-info-circle"></i>
            <div>
                <strong>¡Atención!</strong> Como usuario no registrado, puedes consultar nuestra colección de libros.
                Para poder realizar préstamos, por favor, <a href="@Url.Action("Registro", "Cuenta")">regístrate aquí</a> o <a href="@Url.Action("Login", "Cuenta")">inicia sesión</a> si ya tienes una cuenta.
            </div>
        </div>
    }

    <h2 class="section-title">Nuestra Colección de Libros</h2>

    <div class="book-grid">
        @foreach (var libro in Model)
        {
            <div class="book-card">
                <div>
                    <h4>@libro.Titulo</h4>
                    <p><strong>Autor:</strong> @(libro.AUTOR != null ? libro.AUTOR.Descripcion : "N/A")</p>
                    <p><strong>Categoría:</strong> @(libro.CATEGORIA != null ? libro.CATEGORIA.Descripcion : "N/A")</p>
                </div>

                <div id="bookDetails_@libro.IdLibro" class="book-details-collapsed">
                    <p><strong>Edición:</strong> @libro.Edicion</p>
                    <p><strong>Año:</strong> @libro.AnioPublicacion</p>
                    <p><strong>Editorial:</strong> @(libro.EDITORIAL != null ? libro.EDITORIAL.Descripcion : "N/A")</p>
                </div>

                <button class="toggle-details-btn" data-target="#bookDetails_@libro.IdLibro">
                    Ver Detalles <i class="fas fa-chevron-down"></i>
                </button>
            </div>
        }
    </div>

    <div class="suggestions-section">
        <h3>Sugerencias de Bibliografía</h3>

        @if (sugerencias != null && sugerencias.Any())
        {
            <ul class="suggestion-list">
                @foreach (var libro in sugerencias)
                {
                    <li class="suggestion-item">
                        <i class="fas fa-book"></i>
                        <span><strong>@libro.Titulo</strong> - @(libro.AUTOR?.Descripcion ?? "Sin autor")</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="suggestion-empty">No hay sugerencias disponibles en este momento.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.toggle-details-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const targetId = this.dataset.target;
                    const targetElement = document.querySelector(targetId);
                    const icon = this.querySelector('i');

                    if (targetElement.classList.contains('show')) {
                        targetElement.classList.remove('show');
                        icon.classList.remove('fa-chevron-up');
                        icon.classList.add('fa-chevron-down');
                        this.textContent = 'Ver Detalles ';
                        this.appendChild(icon);
                    } else {
                        targetElement.classList.add('show');
                        icon.classList.remove('fa-chevron-down');
                        icon.classList.add('fa-chevron-up');
                        this.textContent = 'Ocultar Detalles ';
                        this.appendChild(icon);
                    }
                });
            });
        });
    </script>
}