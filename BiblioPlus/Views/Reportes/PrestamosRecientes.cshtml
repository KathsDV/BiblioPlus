@model List<BiblioPlus.Models.vw_PrestamosRecientes>
@{
    ViewBag.Title = "PrestamosRecientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .section-title {
        text-align: center;
        margin-bottom: 50px;
        color: #2c3e50;
        font-size: 2.8em;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .table-card-container {
        background: linear-gradient(135deg, #f0f4f8 0%, #e0e6ed 100%);
        border-radius: 16px;
        border: 1px solid rgba(0, 123, 255, 0.2);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        padding: 30px;
        margin: 40px auto;
        max-width: 1200px;
        overflow-x: auto;
    }

    #tablaPrestamos {
        width: 100% !important;
        border-collapse: collapse;
        margin-top: 20px;
    }

        #tablaPrestamos thead th {
            background-color: #007bff;
            color: #fff;
            padding: 15px;
            text-align: center; /* Centrar texto en encabezados */
            border-bottom: 2px solid #0056b3;
            font-weight: 700;
        }

        #tablaPrestamos tbody td {
            padding: 12px 15px;
            border-bottom: 1px solid #e0e0e0;
            color: #4a4a4a;
            text-align: center; /* Centrar texto en celdas del cuerpo */
        }

        #tablaPrestamos tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        #tablaPrestamos tbody tr:hover {
            background-color: #e9f5ff;
            cursor: pointer;
        }

    /* Ocultamos los estilos del filtro de búsqueda que ya no se usará */
    .dataTables_wrapper .dataTables_filter {
        display: none;
    }

    .dataTables_wrapper .dataTables_length select {
        border: 1px solid #ced4da;
        border-radius: .25rem;
        padding: .375rem .75rem;
        margin-left: .5rem;
        margin-right: .5rem;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: .5em 1em;
        margin-left: 2px;
        border-radius: .25rem;
        background-color: #007bff;
        color: white !important;
        border: none;
        transition: background-color 0.3s ease;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
            background-color: #0056b3;
            color: white !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background-color: #0056b3;
            color: white !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover,
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:active {
            background-color: #e9ecef;
            color: #6c757d !important;
            cursor: not-allowed;
        }

    .dt-buttons .dt-button {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 8px 15px;
        margin-right: 5px;
        border-radius: .25rem;
        transition: background-color 0.3s ease;
    }

        .dt-buttons .dt-button:hover {
            background-color: #218838;
        }
</style>

<h2 class="section-title">Préstamos Recientes (últimos 30 días)</h2>

<div class="table-card-container">
    <table id="tablaPrestamos" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Préstamo</th>
                <th>Título</th>
                <th>Lector</th>
                <th>Fecha Préstamo</th>
                <th>Fecha Devolución</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.IdPrestamo</td>
                    <td>@p.Titulo</td>
                    <td>@p.Lector</td>
                    <td>@(p.FechaEntregado.HasValue ? p.FechaEntregado.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td>
                        @if (p.FechaDevolucion.HasValue)
                        {
                            <span>@p.FechaDevolucion.Value.ToString("dd/MM/yyyy")</span>
                        }
                        else
                        {
                            <span>Pendiente</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaPrestamos').DataTable({
                dom: 'Brtip', // Eliminado 'f' para quitar el Search/Filter
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ]
            });
        });
    </script>
}