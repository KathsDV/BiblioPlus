<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BIBLIO PLUS - @ViewBag.Title</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f8f9fa;
        }

        .navbar-custom {
            background-color: #2c3e50;
            border-bottom: 4px solid #3498db;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .navbar-custom.scrolled {
                background-color: #1e2b3b;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
            }

        .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: #ecf0f1 !important;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s ease, transform 0.3s ease, text-shadow 0.3s ease;
            text-shadow: 0 0 2px #f0f0f0;
        }

            .navbar-brand:hover {
                color: #ffffff !important;
                transform: scale(1.02);
                text-shadow: 0 0 5px #ffffff, 0 0 10px #ffffff;
            }

            .navbar-brand .fas.fa-book {
                color: #ecf0f1;
                font-size: 1.8rem;
                vertical-align: middle;
                margin-right: 8px;
                transition: transform 0.3s ease;
            }

            .navbar-brand:hover .fas.fa-book {
                transform: rotate(5deg) scale(1.1);
            }

        .navbar-nav .nav-link {
            color: #bdc3c7 !important;
            font-size: 1.05rem;
            font-weight: 500;
            margin-right: 18px;
            padding: 10px 18px;
            border-radius: 8px;
            transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .dropdown-item:hover {
                background-color: #3498db;
                color: #ffffff !important;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            }

            .navbar-nav .nav-link.active {
                background-color: #2980b9;
                color: #ffffff !important;
                font-weight: 600;
                border-bottom: 2px solid #ffffff;
            }

        .dropdown-menu {
            background-color: #2c3e50;
            border: none;
        }

        .dropdown-item {
            color: #bdc3c7;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.3) !important;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml;charset=utf8,%3Csvg viewBox='0 0 30 30' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath stroke='rgba%28255, 255, 255, 0.7%29' stroke-width='2' stroke-linecap='round' stroke-miterlimit='10' d='M4 7h22M4 15h22M4 23h22'/%3E%3C/svg%3E") !important;
        }

        .body-content {
            padding-top: 30px;
            padding-bottom: 20px;
        }

        footer {
            margin-top: 50px;
            padding: 25px 0;
            border-top: 1px solid #e0e0e0;
            color: #7f8c8d;
            text-align: center;
            font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="fas fa-book"></i> BIBLIO PLUS
            </a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (Session["Usuario"] != null)
                    {
                        var cuenta = (BiblioPlus.Models.Persona)Session["Usuario"];
                        <li class="nav-item">
                            @Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" + (ViewContext.RouteData.Values["controller"].ToString() == "Home" ? " active" : "") })
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"].ToString().StartsWith("CATEGORIAS") || ViewContext.RouteData.Values["controller"].ToString().StartsWith("EDITORIAL") || ViewContext.RouteData.Values["controller"].ToString().StartsWith("AUTOR") || ViewContext.RouteData.Values["controller"].ToString().StartsWith("LIBRO") ? "active" : "")"
                               href="#" id="gestionLibrosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Gestión de Libros
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="gestionLibrosDropdown">
                                <li>@Html.ActionLink("Categorías", "Index", "Categorias", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Editoriales", "Index", "EDITORIALs", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Autores", "Index", "AUTORs", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Libros", "Index", "LIBROs", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>

                        if (cuenta.TIPO_PERSONA.Descripcion == "Admin") // Asumiendo que "IdTipoPersona == 1" es "Admin"
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Compra de Libros", "Index", "OrdenCompra", null,
                                                              new { @class = "nav-link" + (ViewContext.RouteData.Values["controller"].ToString() == "OrdenCompra" ? " active" : "") })
                            </li>
                        }

                        // Lógica para "Préstamos" y "Penalizaciones"
                        if (cuenta.TIPO_PERSONA.Descripcion == "Usuario") // Si es Usuario, ve "Prestamos" normal y "Penalizaciones"
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Prestamos", "Index", "PRESTAMOs", null, new { @class = "nav-link" + (ViewContext.RouteData.Values["controller"].ToString() == "PRESTAMOs" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? " active" : "") })
                            </li>
                            <li class="nav-item">
                                @Html.ActionLink("Penalizaciones", "Penalizacion", "PRESTAMOs", null, new { @class = "nav-link" + (ViewContext.RouteData.Values["controller"].ToString() == "PRESTAMOs" && ViewContext.RouteData.Values["action"].ToString() == "Penalizacion" ? " active" : "") })
                            </li>
                        }
                        else // Si es Admin, ve "Prestamos" (Admin)
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Prestamos", "Admin", "PRESTAMOs", null, new { @class = "nav-link" + (ViewContext.RouteData.Values["controller"].ToString() == "PRESTAMOs" && ViewContext.RouteData.Values["action"].ToString() == "Admin" ? " active" : "") })
                            </li>
                        }

                        if (cuenta.TIPO_PERSONA.Descripcion == "Admin") // Asumiendo que "IdTipoPersona == 1" es "Admin"
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(new[] { "Reportes" }.Contains(ViewContext.RouteData.Values["controller"].ToString()) ? "active" : "")" href="#" id="reportesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Reportes
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="reportesDropdown">
                                    <li>@Html.ActionLink("Destacados del Mes", "DestacadosDelMes", "Reportes", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Libros Más Prestados", "LibrosMasPrestados", "Reportes", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Préstamos Recientes", "PrestamosRecientes", "Reportes", null, new { @class = "dropdown-item" })</li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            @Html.ActionLink("Conócenos", "Conocenos", "Cuenta", null, new { @class = "nav-link" + (ViewContext.RouteData.Values["controller"].ToString() == "Cuenta" && ViewContext.RouteData.Values["action"].ToString() == "Conocenos" ? " active" : "") })
                        </li>
                    }

                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (Session["Usuario"] == null)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Iniciar Sesión", "Login", "Cuenta", null,
                                                          new { @class = "nav-link" + (ViewContext.RouteData.Values["action"].ToString() == "Login" ? " active" : "") })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Registrarse", "Registro", "Cuenta", null,
                                                          new { @class = "nav-link" + (ViewContext.RouteData.Values["action"].ToString() == "Registro" ? " active" : "") })
                        </li>
                    }
                    else // Este bloque se ejecuta si Session["Usuario"] NO es nulo (es decir, el usuario está logueado)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Cerrar Sesión", "Logout", "Cuenta", null,
                                                          new { @class = "nav-link" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content" style="margin-top: 80px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade in" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <strong>Éxito:</strong> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <strong>Error:</strong> @TempData["ErrorMessage"]
            </div>
        }

        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - BIBLIO PLUS | ITCA-FEPADE</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(window).scroll(function () {
            if ($(document).scrollTop() > 50) {
                $('.navbar-custom').addClass('scrolled');
            } else {
                $('.navbar-custom').removeClass('scrolled');
            }
        });
    </script>
</body>
</html>