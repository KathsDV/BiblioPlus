@model IEnumerable<BiblioPlus.Models.AUTOR>

@{
    ViewBag.Title = "Gestión de Autores";
    int tipoUsuario = Session["IdTipoPersona"] != null ? Convert.ToInt32(Session["IdTipoPersona"]) : 0;
}

<h2 class="text-primary mt-4 mb-4">
    <i class="fas fa-user-edit me-2"></i> Gestión de Autores
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i> Listado de Autores</h5>
        @if (tipoUsuario == 1)
        {
            <a href="@Url.Action("Create")" class="btn btn-light btn-sm" title="Crear Nuevo Autor" aria-label="Crear Nuevo Autor">
                <i class="fas fa-plus-circle me-2 text-primary"></i> Crear Nuevo Autor
            </a>
        }
    </div>
    <div class="card-body">
        @* Mensajes de TempData *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="mb-3">
            @using (Html.BeginForm("Index", "AUTORs", FormMethod.Get, new { @class = "row g-3 align-items-center" }))
            {
                <div class="col-12 col-md-auto">
                    <label for="searchString" class="form-label">Buscar por Autor:</label>
                </div>
                <div class="col-12 col-md-5 col-lg-4">
                    @Html.TextBox("searchString", ViewBag.CurrentFilter as string, new { @class = "form-control", placeholder = "Ingrese autor" })
                </div>
                <div class="col-12 col-md-auto d-flex flex-wrap justify-content-center justify-content-md-start">
                    <button type="submit" class="btn btn-info me-2"><i class="fas fa-search me-1"></i> Buscar</button>
                    @Html.ActionLink("Ver Todas", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().IdAutor)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().Descripcion)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().Estado)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().FechaCreacion)
                        </th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.IdAutor)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Descripcion)
                            </td>
                            <td>
                                @{
                                    string estadoTexto = "Desconocido"; // Por defecto, si es null o no es true/false
                                    string badgeClass = "bg-secondary"; // Color por defecto

                                    // Verifica si el Estado tiene un valor y luego qué valor es
                                    if (item.Estado.HasValue)
                                    {
                                        if (item.Estado.Value == true)
                                        {
                                            estadoTexto = "Activo";
                                            badgeClass = "bg-success";
                                        }
                                        else // item.Estado.Value == false
                                        {
                                            estadoTexto = "Inactivo";
                                            badgeClass = "bg-danger";
                                        }
                                    }
                                }
                                <span class="badge @badgeClass">@estadoTexto</span>
                            </td>
                            <td>
                                @* ¡AJUSTE REALIZADO AQUÍ PARA QUITAR LOS SEGUNDOS! *@
                                @(item.FechaCreacion.HasValue ? item.FechaCreacion.Value.ToString("MM/dd/yyyy hh:mm tt") : "N/A")
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Acciones de Autor">
                                    @if (tipoUsuario == 1)
                                    {
                                        <a href="@Url.Action("Edit", new { id = item.IdAutor })" class="btn btn-sm btn-warning" title="Editar Autor" aria-label="Editar Autor">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    <a href="@Url.Action("Details", new { id = item.IdAutor })" class="btn btn-sm btn-info ms-1" title="Ver Detalles" aria-label="Ver Detalles">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    @if (tipoUsuario == 1)
                                    {
                                        <a href="@Url.Action("Delete", new { id = item.IdAutor })" class="btn btn-sm btn-danger ms-1" title="Eliminar Autor" aria-label="Eliminar Autor">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>$(document).ready(function () {
                window.setTimeout(function () {
                    $(".alert").fadeTo(500, 0).slideUp(500, function () {
                        $(this).remove();
                    });
                }, 4000);
            });</script>
}

