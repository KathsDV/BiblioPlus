@model BiblioPlus.Models.AUTOR

@{
    ViewBag.Title = "Crear Nuevo Autor";
}

<h2 class="text-primary mt-4 mb-4">
    <i class="fas fa-plus-circle me-2"></i> Crear Nuevo Autor
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Formulario de Nuevo Autor</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @* Adaptado de CATEGORIA/Create.cshtml para "Detalles del Autor" *@
                <h4 class="mb-3">Detalles del Autor</h4> @* Se usa h4 y mb-3 para el margen inferior *@
                <hr class="mb-4" /> @* Se usa hr y mb-4 para el margen inferior de la línea *@
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3 row">
                    @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "col-md-2 col-form-label" }) @* Añadido col-form-label *@
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.LabelFor(model => model.Estado, htmlAttributes: new { @class = "col-md-2 col-form-label" }) @* Añadido col-form-label *@
                    <div class="col-md-10">
                        <div class="form-check form-switch mt-2">
                            @* Ajuste de margen superior para el switch *@
                            @Html.CheckBox("Estado", Model != null && Model.Estado.GetValueOrDefault(false), new { @class = "form-check-input", id = "Estado" })
                            <label class="form-check-label" for="Estado">
                                @(Model != null && Model.Estado.GetValueOrDefault(false) ? "Activo" : "Inactivo")
                            </label>
                        </div>
                        @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.LabelFor(model => model.FechaCreacion, htmlAttributes: new { @class = "col-md-2 col-form-label" }) @* Añadido col-form-label *@
                    <div class="col-md-10">
                        @* Usamos type="datetime-local" para incluir fecha y hora sin segundos en el input *@
                        @Html.EditorFor(model => model.FechaCreacion, new { htmlAttributes = new { @class = "form-control", type = "datetime-local", @Value = (Model != null && Model.FechaCreacion.HasValue) ? Model.FechaCreacion.Value.ToString("yyyy-MM-ddTHH:mm") : "" } })
                        @Html.ValidationMessageFor(model => model.FechaCreacion, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-2"></i> Crear</button>
                    @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>$(document).ready(function () {
            // Inicializar el texto al cargar la página
            if ($('#Estado').is(':checked')) {
                $('#Estado').next('label').text('Activo');
            } else {
                $('#Estado').next('label').text('Inactivo');
            }

            // Actualizar el texto cuando el estado cambia
            $('#Estado').change(function () {
                if ($(this).is(':checked')) {
                    $(this).next('label').text('Activo');
                } else {
                    $(this).next('label').text('Inactivo');
                }
            });
        });</script>
}
