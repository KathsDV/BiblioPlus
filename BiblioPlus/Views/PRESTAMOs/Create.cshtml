@model BiblioPlus.Models.PRESTAMO

@{
    ViewBag.Title = "Solicitar Préstamo";
}

<h2 class="text-primary mt-4 mb-4">
    <i class="fas fa-plus-circle me-2"></i> Solicitar Préstamo
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i> Formulario de Solicitud de Préstamo</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                <h4>Detalles del Préstamo</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3 row">
                    @Html.LabelFor(model => model.IdLibro, "Libro", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("IdLibro", null, "Seleccione un libro", new { @class = "form-control", @id = "IdLibro" })
                        @Html.ValidationMessageFor(model => model.IdLibro, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="control-label col-md-2" for="diasPrestamo">Días de préstamo (máximo 14):</label>
                    <div class="col-md-10">
                        @Html.DropDownList("diasPrestamo", ViewBag.DiasMaximos as IEnumerable<SelectListItem>, "Seleccione", new { @class = "form-control" })
                        @Html.ValidationMessage("diasPrestamo", "", new { @class = "text-danger" }) @* ValidationMessage sin For *@
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-2"></i> Solicitar</button>
                    @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            $('#IdLibro').select2({
                placeholder: "Seleccione un libro",
                allowClear: true
            });
        });
    </script>
}