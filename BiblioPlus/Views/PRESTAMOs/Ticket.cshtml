@model BiblioPlus.Models.PRESTAMO
@{
    ViewBag.Title = "Ticket de Préstamo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Ticket de Préstamo</h2>
    <hr />

    <div id="ticket" class="card p-3">
        <p><strong>ID del Préstamo:</strong> @Model.IdPrestamo</p>
        <p><strong>Nombre del Usuario:</strong> @Model.Persona.Nombre @Model.Persona.Apellido</p>
        <p><strong>Correo:</strong> @Model.Persona.Correo</p>
        <p><strong>Libro:</strong> @Model.LIBRO.Titulo</p>
        <p><strong>Fecha de Solicitud:</strong> @Model.FechaCreacion</p>
        <p><strong>Fecha de Devolución:</strong> @Model.FechaDevolucion</p>
        <p><strong>Estado:</strong> @Model.ESTADO_PRESTAMO.Descripcion</p>
    </div>

    <div class="mt-3 no-print">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
        <button onclick="printTicket()" class="btn btn-outline-dark">Imprimir Ticket</button>
    </div>
</div>

@section Scripts {
    <script>function printTicket() {
            var contenido = document.getElementById("ticket").innerHTML;
            var ventana = window.open("", "_blank", "width=600,height=600");
            ventana.document.write(`
                    <html>
                        <head>
                            <title>Ticket de Préstamo</title>
                            <style>
                                body { font-family: Arial, sans-serif; padding: 20px; }
                                p { margin: 5px 0; }
                            </style>
                        </head>
                        <body>
                            ${contenido}
                            <script>window.onload = function() { window.print(); window.close(); }<\/script>
                        </body>
                    </html>
                `);
            ventana.document.close();
        }</script>
}