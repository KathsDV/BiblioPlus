@model IEnumerable<BiblioPlus.Models.PENALIZACION>

@{
    ViewBag.Title = "Mis Penalizaciones";
}

<h2 class="text-primary mt-4 mb-4">
    <i class="fas fa-exclamation-circle me-2"></i> Mis Penalizaciones
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list-alt me-2"></i> Listado de Penalizaciones</h5>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().PRESTAMO.LIBRO.Titulo)</th>
                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Motivo)</th>
                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Monto)</th>
                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().FechaRegistro)</th>
                        <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Pagado)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.PRESTAMO.LIBRO.Titulo)</td>
                            <td>@Html.DisplayFor(modelItem => item.Motivo)</td>
                            <td>$@Html.DisplayFor(modelItem => item.Monto)</td>
                            <td>@(item.FechaRegistro.HasValue ? item.FechaRegistro.Value.ToString("dd/MM/yyyy hh:mm tt") : "N/A")</td>
                            <td>
                                @{
                                    string estadoPagoTexto = item.Pagado.GetValueOrDefault(false) ? "Sí" : "No";
                                    string estadoPagoBadgeClass = item.Pagado.GetValueOrDefault(false) ? "bg-success" : "bg-danger";
                                }
                                <span class="badge @estadoPagoBadgeClass">@estadoPagoTexto</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>$(document).ready(function () {
            window.setTimeout(function () {
                $(".alert").fadeTo(500, 0).slideUp(500, function () {
                    $(this).remove();
                });
            }, 4000);
        });</script>
}