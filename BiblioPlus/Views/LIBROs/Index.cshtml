@model IEnumerable<BiblioPlus.Models.LIBRO>

@{
    ViewBag.Title = "Gestión de Libros";
    int tipoUsuario = Session["IdTipoPersona"] != null ? Convert.ToInt32(Session["IdTipoPersona"]) : 0;
}

<h2 class="text-primary mt-4 mb-4">
    <i class="fas fa-book-reader me-2"></i> Gestión de Libros
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i> Listado de Libros</h5>
        @if (tipoUsuario == 1)
        {
            <a href="@Url.Action("Create")" class="btn btn-light btn-sm" title="Crear Nuevo Libro" aria-label="Crear Nuevo Libro">
                <i class="fas fa-plus-circle me-2 text-primary"></i> Crear Nuevo Libro
            </a>
        }
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="mb-3">
            @using (Html.BeginForm("Index", "LIBROs", FormMethod.Get, new { @class = "row g-3 align-items-center" }))
            {
                <div class="col-12 col-md-auto">
                    <label for="searchString" class="form-label">Buscar por Libro:</label>
                </div>
                <div class="col-12 col-md-5 col-lg-4">
                    @Html.TextBox("searchString", ViewBag.CurrentFilter as string, new { @class = "form-control", placeholder = "Ingrese libro" })
                </div>
                <div class="col-12 col-md-auto d-flex flex-wrap justify-content-center justify-content-md-start">
                    <button type="submit" class="btn btn-info me-2"><i class="fas fa-search me-1"></i> Buscar</button>
                    @Html.ActionLink("Ver Todas", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="text-align: center; vertical-align: middle;">@Html.DisplayNameFor(model => model.FirstOrDefault().Titulo)</th>
                        <th style="text-align: center; vertical-align: middle;">@Html.DisplayNameFor(model => model.FirstOrDefault().Edicion)</th>
                        <th style="text-align: center; vertical-align: middle;">@Html.DisplayNameFor(model => model.FirstOrDefault().AnioPublicacion)</th>
                        <th style="text-align: center; vertical-align: middle;">@Html.DisplayNameFor(model => model.FirstOrDefault().Estado)</th>
                        <th style="text-align: center; vertical-align: middle;">Categoría</th>
                        <th style="text-align: center; vertical-align: middle;">Editorial</th>
                        <th style="text-align: center; vertical-align: middle;">Autor</th>
                        <th style="text-align: center; vertical-align: middle;">@Html.DisplayNameFor(model => model.FirstOrDefault().StockActual)</th>
                        <th style="text-align: center; vertical-align: middle;">@Html.DisplayNameFor(model => model.FirstOrDefault().FechaCreacion)</th>
                        <th style="text-align: center; vertical-align: middle;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                            <td>@Html.DisplayFor(modelItem => item.Edicion)</td>
                            <td>@Html.DisplayFor(modelItem => item.AnioPublicacion)</td>
                            <td>
                                @{
                                    string badgeClass = "";
                                    switch (item.Estado)
                                    {
                                        case "Libre":
                                            badgeClass = "bg-success";
                                            break;
                                        case "Prestado":
                                            badgeClass = "bg-warning text-dark";
                                            break;
                                        case "En Reparacion":
                                            badgeClass = "bg-info text-dark";
                                            break;
                                        case "Extraviado":
                                            badgeClass = "bg-danger";
                                            break;
                                        default:
                                            badgeClass = "bg-secondary";
                                            break;
                                    }
                                }
                                <span class="badge @badgeClass">@Html.DisplayFor(modelItem => item.Estado)</span>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.CATEGORIA.Descripcion)</td>
                            <td>@Html.DisplayFor(modelItem => item.EDITORIAL.Descripcion)</td>
                            <td>@Html.DisplayFor(modelItem => item.AUTOR.Descripcion)</td>
                            <td class="@(item.StockActual <= 5 ? "table-warning text-danger fw-bold" : "")">
                                @Html.DisplayFor(modelItem => item.StockActual)
                                @if (item.StockActual <= 5)
                                {
                                    <i class="fas fa-exclamation-triangle ms-1" title="Stock bajo"></i>
                                }
                            </td>
                            <td>
                                @(item.FechaCreacion.HasValue ? item.FechaCreacion.Value.ToString("MM/dd/yyyy hh:mm tt") : "N/A")
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Acciones de Libro">
                                    @if (tipoUsuario == 1)
                                    {
                                        <a href="@Url.Action("Edit", new { id = item.IdLibro })" class="btn btn-sm btn-warning" title="Editar Libro"><i class="fas fa-pencil-alt"></i></a>
                                    }
                                    <a href="@Url.Action("Details", new { id = item.IdLibro })" class="btn btn-sm btn-info ms-1" title="Ver Detalles"><i class="fas fa-info-circle"></i></a>
                                    @if (tipoUsuario == 1)
                                    {
                                        <a href="@Url.Action("Delete", new { id = item.IdLibro })" class="btn btn-sm btn-danger ms-1" title="Eliminar Libro"><i class="fas fa-trash-alt"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            window.setTimeout(function () {
                $(".alert").fadeTo(500, 0).slideUp(500, function () {
                    $(this).remove();
                });
            }, 4000);
        });
    </script>
}