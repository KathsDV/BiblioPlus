@model IEnumerable<BiblioPlus.Models.CATEGORIA>

@{
    ViewBag.Title = "Gestión de Categorías";
    int tipoUsuario = Session["IdTipoPersona"] != null ? Convert.ToInt32(Session["IdTipoPersona"]) : 0;
}

<h2 class="text-primary mt-4 mb-4">
    <i class="fas fa-tags me-2"></i> Gestión de Categorías
</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i> Listado de Categorías</h5>
        @if (tipoUsuario == 1)
        {
            <a href="@Url.Action("Create")" class="btn btn-light btn-sm" title="Crear Nueva Categoría" aria-label="Crear Nueva Categoría">
                <i class="fas fa-plus-circle me-2 text-primary"></i> Crear Nueva Categoría
            </a>
        }
    </div>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="mb-3">
            @using (Html.BeginForm("Index", "CATEGORIAs", FormMethod.Get, new { @class = "row g-3 align-items-center" }))
            {
                <div class="col-12 col-md-auto">
                    <label for="searchString" class="form-label">Buscar por Categoría:</label>
                </div>
                <div class="col-12 col-md-5 col-lg-4">
                    @Html.TextBox("searchString", ViewBag.CurrentFilter as string, new { @class = "form-control", placeholder = "Ingrese categoria" })
                </div>
                <div class="col-12 col-md-auto d-flex flex-wrap justify-content-center justify-content-md-start">
                    <button type="submit" class="btn btn-info me-2"><i class="fas fa-search me-1"></i> Buscar</button>
                    @Html.ActionLink("Ver Todas", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().IdCategoria)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().Descripcion)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().Estado)
                        </th>
                        <th class="text-center">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().FechaCreacion)
                        </th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.IdCategoria)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Descripcion)
                            </td>
                            <td>
                                @{
                                    string estadoTexto = item.Estado.GetValueOrDefault(false) ? "Activo" : "Inactivo";
                                    string badgeClass = item.Estado.GetValueOrDefault(false) ? "bg-success" : "bg-danger";
                                }
                                <span class="badge @badgeClass">@estadoTexto</span>
                            </td>
                            <td>
                                @* Formato de fecha SIN segundos *@
                                @(item.FechaCreacion.HasValue ? item.FechaCreacion.Value.ToString("MM/dd/yyyy hh:mm tt") : "N/A")
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Acciones de Categoría">
                                    @if (tipoUsuario == 1)
                                    {
                                        <a href="@Url.Action("Edit", new { id = item.IdCategoria })" class="btn btn-sm btn-warning" title="Editar Categoría" aria-label="Editar Categoría">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                        <a href="@Url.Action("Details", new { id = item.IdCategoria })" class="btn btn-sm btn-info ms-1" title="Ver Detalles" aria-label="Ver Detalles">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                    @if (tipoUsuario == 1)
                                    {
                                        <a href="@Url.Action("Delete", new { id = item.IdCategoria })" class="btn btn-sm btn-danger ms-1" title="Eliminar Categoría" aria-label="Eliminar Categoría">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    }
                                 </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


@section Scripts {
    <script>
        $(document).ready(function () {
            window.setTimeout(function () {
                $(".alert").fadeTo(500, 0).slideUp(500, function () {
                    $(this).remove();
                });
            }, 4000);
        });
    </script>
}
